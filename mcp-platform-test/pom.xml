<?xml version="1.0" encoding="UTF-8"?>
<!--
  mcp-platform-test: test support for MCP servers built on mcp-platform-starter. Test scope only.
    - TestGateway: serves the published test JWKS of mcp-contracts and mints internal JWTs (C2) with the
      published test keys, plus an MCP client request customizer that sends a fresh token per request
  Brings mcp-contracts:test-vectors (test keys) and the MCP client; never put it on a production classpath.
  Its own tests are the starter's end-to-end tests over the real transport.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>pl.aiwcorpo.mcp</groupId>
    <artifactId>mcp-platform-test</artifactId>
    <version>3.0.0-beta-11-SNAPSHOT</version>
    <name>Aiwcorpo MCP Platform :: Test support</name>

    <url>https://github.com/aiwcorpo/mcp-starter-lib</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <scm>
        <url>https://github.com/aiwcorpo/mcp-starter-lib</url>
        <connection>scm:git:https://github.com/aiwcorpo/mcp-starter-lib.git</connection>
    </scm>

    <!-- Published from CI only (.github/workflows/release.yml); the server id "github" gets its credentials from .ci/settings.xml. -->
    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages (aiwcorpo/mcp-starter-lib)</name>
            <url>https://maven.pkg.github.com/aiwcorpo/mcp-starter-lib</url>
        </repository>
    </distributionManagement>

    <properties>
        <java.version>25</java.version>
        <spring-ai.version>2.0.0</spring-ai.version>
        <mcp-contracts.version>6.2.1</mcp-contracts.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>pl.aiwcorpo.mcp</groupId>
            <artifactId>mcp-platform-starter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>pl.aiwcorpo.mcp</groupId>
            <artifactId>mcp-contracts</artifactId>
            <version>${mcp-contracts.version}</version>
            <classifier>test-vectors</classifier>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <!-- Apache-2.0 asks for LICENSE and NOTICE inside every distributed jar. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>license-files</id>
                        <phase>process-resources</phase>
                        <goals><goal>copy-resources</goal></goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/META-INF</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${maven.multiModuleProjectDirectory}</directory>
                                    <includes>
                                        <include>LICENSE</include>
                                        <include>NOTICE</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
