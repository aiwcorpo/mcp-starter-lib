<?xml version="1.0" encoding="UTF-8"?>
<!--
  mcp-platform-test: test support for MCP servers built on mcp-platform-starter. Test scope only.
    - TestGateway: serves the published test JWKS of mcp-contracts and mints internal JWTs (C2) with the
      published test keys, plus an MCP client request customizer that sends a fresh token per request
  Brings mcp-contracts:test-vectors (test keys) and the MCP client; never put it on a production classpath.
  Its own tests are the starter's end-to-end tests over the real transport.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>pl.aiwcorpo.mcp</groupId>
    <artifactId>mcp-platform-test</artifactId>
    <version>4.0.0</version>
    <name>Aiwcorpo MCP Platform :: Test support</name>
    <description>Test support for MCP servers built on mcp-platform-starter: a test gateway that serves a JWKS and mints internal JWTs from the published test keys. Test scope only.</description>

    <url>https://github.com/aiwcorpo/mcp-starter-lib</url>
    <inceptionYear>2026</inceptionYear>

    <organization>
        <name>aiwcorpo</name>
        <url>https://github.com/aiwcorpo</url>
    </organization>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <!-- The organization stands in for a person: Central requires developer information but not an e-mail address,
         and a published POM is public and permanent, so no private address goes into it. -->
    <developers>
        <developer>
            <id>aiwcorpo</id>
            <name>aiwcorpo</name>
            <organization>aiwcorpo</organization>
            <organizationUrl>https://github.com/aiwcorpo</organizationUrl>
        </developer>
    </developers>

    <scm>
        <url>https://github.com/aiwcorpo/mcp-starter-lib</url>
        <connection>scm:git:https://github.com/aiwcorpo/mcp-starter-lib.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/aiwcorpo/mcp-starter-lib.git</developerConnection>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/aiwcorpo/mcp-starter-lib/issues</url>
    </issueManagement>

    <properties>
        <java.version>25</java.version>
        <spring-ai.version>2.0.0</spring-ai.version>
        <mcp-contracts.version>7.0.0</mcp-contracts.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>pl.aiwcorpo.mcp</groupId>
            <artifactId>mcp-platform-starter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>pl.aiwcorpo.mcp</groupId>
            <artifactId>mcp-contracts</artifactId>
            <version>${mcp-contracts.version}</version>
            <classifier>test-vectors</classifier>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <!-- Apache-2.0 asks for LICENSE and NOTICE inside every distributed jar. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>license-files</id>
                        <phase>process-resources</phase>
                        <goals><goal>copy-resources</goal></goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/META-INF</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${maven.multiModuleProjectDirectory}</directory>
                                    <includes>
                                        <include>LICENSE</include>
                                        <include>NOTICE</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- A runnable jar of LocalGateway next to the library jar (classifier local-gateway): one MCP server tested alone
                 with the developer's own token. The library artifact stays a plain jar. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>repackage</id>
                        <goals><goal>repackage</goal></goals>
                        <configuration>
                            <classifier>local-gateway</classifier>
                            <mainClass>pl.aiwcorpo.mcp.platform.test.LocalGateway</mainClass>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!-- Maven Central. Not part of the normal build: `./mvnw -Prelease -Dgpg.skip verify` checks that the sources and javadoc jars
         build; the CI workflow signs and uploads the result itself (.github/workflows/release.yml). A manual release is
         `./mvnw -Prelease deploy`: signed with gpg, uploaded to the Central Portal as one bundle and left there for a person to
         publish (central.autoPublish=false: a failed validation or a wrong version never reaches the public repository, which is
         immutable). Credentials: server id "central" in settings.xml (a Portal user token). The signing passphrase is read from
         MAVEN_GPG_PASSPHRASE or gpg-agent, never from the command line. This profile is repeated in the three poms that do not
         share a parent (aggregator, starter, test: the last two inherit from spring-boot-starter-parent); keep them in step. -->
    <profiles>
        <profile>
            <id>release</id>
            <properties>
                <central.autoPublish>false</central.autoPublish>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>sources-jar</id>
                                <phase>package</phase>
                                <goals><goal>jar-no-fork</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.12.0</version>
                        <configuration>
                            <doclint>all,-missing</doclint>
                            <quiet>true</quiet>
                        </configuration>
                        <executions>
                            <execution>
                                <id>javadoc-jar</id>
                                <phase>package</phase>
                                <goals><goal>jar</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.8</version>
                        <configuration>
                            <bestPractices>true</bestPractices>
                        </configuration>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals><goal>sign</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.10.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>${central.autoPublish}</autoPublish>
                            <deploymentName>mcp-platform ${project.version}</deploymentName>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
