<?xml version="1.0" encoding="UTF-8"?>
<!--
  Aggregator of the shared library for MCP servers behind the platform gateway.

  Modules:
    - mcp-platform-bom     : versions for servers (starter, test support, mcp-contracts, Spring AI)
    - mcp-platform-starter : Spring Boot auto-configuration: internal JWT (C2), backend credential (C3),
                             audit (C8), tool errors (C10); brings the Spring AI MCP server starter
    - mcp-platform-test    : test support for servers (test gateway: JWKS + C2 tokens from the
                             published test keys of mcp-contracts); test scope only

  Versioning: SemVer, one version for all modules. This line (mcp-platform 3.x) is independent of the
  mcp-contracts version (6.x).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>pl.aiwcorpo.mcp</groupId>
    <artifactId>mcp-platform</artifactId>
    <version>3.0.0</version>
    <packaging>pom</packaging>
    <name>Aiwcorpo MCP Platform :: Aggregator</name>
    <description>Aggregator of the MCP platform library for servers behind the gateway: BOM, Spring Boot starter and test support.</description>

    <url>https://github.com/aiwcorpo/mcp-starter-lib</url>
    <inceptionYear>2026</inceptionYear>

    <organization>
        <name>aiwcorpo</name>
        <url>https://github.com/aiwcorpo</url>
    </organization>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <!-- The organization stands in for a person: Central requires developer information but not an e-mail address,
         and a published POM is public and permanent, so no private address goes into it. -->
    <developers>
        <developer>
            <id>aiwcorpo</id>
            <name>aiwcorpo</name>
            <organization>aiwcorpo</organization>
            <organizationUrl>https://github.com/aiwcorpo</organizationUrl>
        </developer>
    </developers>

    <scm>
        <url>https://github.com/aiwcorpo/mcp-starter-lib</url>
        <connection>scm:git:https://github.com/aiwcorpo/mcp-starter-lib.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/aiwcorpo/mcp-starter-lib.git</developerConnection>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/aiwcorpo/mcp-starter-lib/issues</url>
    </issueManagement>

    <modules>
        <module>mcp-platform-bom</module>
        <module>mcp-platform-starter</module>
        <module>mcp-platform-test</module>
    </modules>

    <!-- Maven Central. Not part of the normal build: `./mvnw -Prelease -Dgpg.skip verify` checks that the sources and javadoc jars
         build; the CI workflow signs and uploads the result itself (.github/workflows/release.yml). A manual release is
         `./mvnw -Prelease deploy`: signed with gpg, uploaded to the Central Portal as one bundle and left there for a person to
         publish (central.autoPublish=false: a failed validation or a wrong version never reaches the public repository, which is
         immutable). Credentials: server id "central" in settings.xml (a Portal user token). The signing passphrase is read from
         MAVEN_GPG_PASSPHRASE or gpg-agent, never from the command line. This profile is repeated in the three poms that do not
         share a parent (aggregator, starter, test: the last two inherit from spring-boot-starter-parent); keep them in step. -->
    <profiles>
        <profile>
            <id>release</id>
            <properties>
                <central.autoPublish>false</central.autoPublish>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.8</version>
                        <configuration>
                            <bestPractices>true</bestPractices>
                        </configuration>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals><goal>sign</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.10.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>${central.autoPublish}</autoPublish>
                            <deploymentName>mcp-platform ${project.version}</deploymentName>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
