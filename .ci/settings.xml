<?xml version="1.0" encoding="UTF-8"?>
<!--
  Maven settings for CI: the mcp-contracts artifacts (mcp-policy-bundle, mcp-cedar-entities, mcp-manifest, mcp-contracts and its
  test-vectors jar) come from the company Maven registry, not from Maven Central. Used by ci/run.sh when
  MCP_MAVEN_REPOSITORY_URL is set. GitLab package registry: URL .../api/v4/projects/<id>/packages/maven (or the group
  endpoint), user and password of a deploy token with read_package_registry. GitHub Packages: URL
  https://maven.pkg.github.com/aiwcorpo/mcp-contracts, user and a token with read:packages. The server id "github" is the one
  distributionManagement of the poms names; only the release workflow fills GITHUB_ACTOR and GITHUB_TOKEN.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
    <servers>
        <server>
            <id>github</id>
            <username>${env.GITHUB_ACTOR}</username>
            <password>${env.GITHUB_TOKEN}</password>
        </server>
        <server>
            <id>mcp-artifacts</id>
            <username>${env.MCP_MAVEN_REPOSITORY_USER}</username>
            <password>${env.MCP_MAVEN_REPOSITORY_PASSWORD}</password>
        </server>
    </servers>
    <profiles>
        <profile>
            <id>mcp-artifacts</id>
            <repositories>
                <repository>
                    <id>mcp-artifacts</id>
                    <url>${env.MCP_MAVEN_REPOSITORY_URL}</url>
                    <releases><enabled>true</enabled></releases>
                    <snapshots><enabled>false</enabled></snapshots>
                </repository>
            </repositories>
        </profile>
    </profiles>
    <activeProfiles>
        <activeProfile>mcp-artifacts</activeProfile>
    </activeProfiles>
</settings>
