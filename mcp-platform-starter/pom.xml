<?xml version="1.0" encoding="UTF-8"?>
<!--
  mcp-platform-starter: Spring Boot auto-configuration for an MCP server behind the platform gateway.
  A server adds this one dependency and gets:
    - InternalJwtFilter: the gateway's internal JWT (C2) on every request, jti replay protection in Redis,
      CallerContext for the rest of the request
    - CredentialContext: the backend credential the gateway injected (C3), or X-PAT-<system> in dev-pat mode
    - AuditingToolCallback: audit events (C8) and safe tool errors (C10) around every tool
    - CorrelationIdFilter (X-Request-Id), SecurityHeadersFilter, CredentialTransportGuard
    - the Spring AI MCP server starter (streamable HTTP)
  It is a library (jar), not an application: no spring-boot-maven-plugin repackage.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Servers must use the same Spring Boot parent version. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>pl.aiwcorpo.mcp</groupId>
    <artifactId>mcp-platform-starter</artifactId>
    <version>3.0.0</version>
    <name>Aiwcorpo MCP Platform :: Starter (auto-configuration)</name>
    <description>Spring Boot starter for MCP servers behind the MCP platform gateway: internal JWT verification, backend credential, resource policy, audit and safe tool errors.</description>

    <url>https://github.com/aiwcorpo/mcp-starter-lib</url>
    <inceptionYear>2026</inceptionYear>

    <organization>
        <name>aiwcorpo</name>
        <url>https://github.com/aiwcorpo</url>
    </organization>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <!-- The organization stands in for a person: Central requires developer information but not an e-mail address,
         and a published POM is public and permanent, so no private address goes into it. -->
    <developers>
        <developer>
            <id>aiwcorpo</id>
            <name>aiwcorpo</name>
            <organization>aiwcorpo</organization>
            <organizationUrl>https://github.com/aiwcorpo</organizationUrl>
        </developer>
    </developers>

    <scm>
        <url>https://github.com/aiwcorpo/mcp-starter-lib</url>
        <connection>scm:git:https://github.com/aiwcorpo/mcp-starter-lib.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/aiwcorpo/mcp-starter-lib.git</developerConnection>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/aiwcorpo/mcp-starter-lib/issues</url>
    </issueManagement>

    <properties>
        <java.version>25</java.version>
        <spring-ai.version>2.0.0</spring-ai.version>
        <mcp-contracts.version>6.3.2</mcp-contracts.version>
        <!-- Same version Spring Security 7.1.0 (Boot 4.1.0) brings; Boot does not manage it. -->
        <nimbus-jose-jwt.version>10.9</nimbus-jose-jwt.version>
        <json-schema-validator.version>3.0.8</json-schema-validator.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-web</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-actuator</artifactId></dependency>
        <dependency><groupId>io.micrometer</groupId><artifactId>micrometer-registry-prometheus</artifactId></dependency>

        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
        </dependency>

        <!-- jti replay store (C2). Connection settings: spring.data.redis.*. -->
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-data-redis</artifactId></dependency>

        <!-- ES256 verification and JWK parsing. -->
        <dependency>
            <groupId>com.nimbusds</groupId>
            <artifactId>nimbus-jose-jwt</artifactId>
            <version>${nimbus-jose-jwt.version}</version>
        </dependency>

        <!-- Claims of the internal JWT are validated against schemas/internal-jwt.schema.json from the
             contracts jar itself, not against a copy of its rules. -->
        <dependency>
            <groupId>pl.aiwcorpo.mcp</groupId>
            <artifactId>mcp-contracts</artifactId>
            <version>${mcp-contracts.version}</version>
        </dependency>
        <!-- Cedar entity builder and result filter shared with the gateway (C7, C9). Brings cedar-java with its native
             libraries (glibc or macOS, no musl). -->
        <dependency>
            <groupId>pl.aiwcorpo.mcp</groupId>
            <artifactId>mcp-cedar-entities</artifactId>
            <version>${mcp-contracts.version}</version>
        </dependency>
        <!-- Verification, rollback protection and atomic swap of policy bundles (C7), the gateway's receiver too. -->
        <dependency>
            <groupId>pl.aiwcorpo.mcp</groupId>
            <artifactId>mcp-policy-bundle</artifactId>
            <version>${mcp-contracts.version}</version>
        </dependency>
        <!-- definitionHash and the semantic rules of the manifest (C6), the same the gateway applies at registration. -->
        <dependency>
            <groupId>pl.aiwcorpo.mcp</groupId>
            <artifactId>mcp-manifest</artifactId>
            <version>${mcp-contracts.version}</version>
        </dependency>
        <dependency>
            <groupId>com.networknt</groupId>
            <artifactId>json-schema-validator</artifactId>
            <version>${json-schema-validator.version}</version>
        </dependency>

        <dependency><groupId>tools.jackson.core</groupId><artifactId>jackson-databind</artifactId></dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>pl.aiwcorpo.mcp</groupId>
            <artifactId>mcp-contracts</artifactId>
            <version>${mcp-contracts.version}</version>
            <classifier>test-vectors</classifier>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <!-- Apache-2.0 asks for LICENSE and NOTICE inside every distributed jar. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>license-files</id>
                        <phase>process-resources</phase>
                        <goals><goal>copy-resources</goal></goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/META-INF</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${maven.multiModuleProjectDirectory}</directory>
                                    <includes>
                                        <include>LICENSE</include>
                                        <include>NOTICE</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!-- Maven Central. Not part of the normal build: `./mvnw -Prelease -Dgpg.skip verify` checks that the sources and javadoc jars
         build; the CI workflow signs and uploads the result itself (.github/workflows/release.yml). A manual release is
         `./mvnw -Prelease deploy`: signed with gpg, uploaded to the Central Portal as one bundle and left there for a person to
         publish (central.autoPublish=false: a failed validation or a wrong version never reaches the public repository, which is
         immutable). Credentials: server id "central" in settings.xml (a Portal user token). The signing passphrase is read from
         MAVEN_GPG_PASSPHRASE or gpg-agent, never from the command line. This profile is repeated in the three poms that do not
         share a parent (aggregator, starter, test: the last two inherit from spring-boot-starter-parent); keep them in step. -->
    <profiles>
        <profile>
            <id>release</id>
            <properties>
                <central.autoPublish>false</central.autoPublish>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>sources-jar</id>
                                <phase>package</phase>
                                <goals><goal>jar-no-fork</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.12.0</version>
                        <configuration>
                            <doclint>all,-missing</doclint>
                            <quiet>true</quiet>
                        </configuration>
                        <executions>
                            <execution>
                                <id>javadoc-jar</id>
                                <phase>package</phase>
                                <goals><goal>jar</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.8</version>
                        <configuration>
                            <bestPractices>true</bestPractices>
                        </configuration>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals><goal>sign</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.10.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>${central.autoPublish}</autoPublish>
                            <deploymentName>mcp-platform ${project.version}</deploymentName>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
