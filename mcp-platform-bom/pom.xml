<?xml version="1.0" encoding="UTF-8"?>
<!--
  mcp-platform-bom: the single source of versions for MCP servers. Servers import this BOM and never pin
  the platform, Spring AI or mcp-contracts versions themselves.

  Spring Boot's own version comes from each server's <parent> (spring-boot-starter-parent) and must be
  the one the starter is built against (5.1.0, see mcp-platform-starter/pom.xml).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>pl.aiwcorpo.mcp</groupId>
        <artifactId>mcp-platform</artifactId>
        <version>4.0.0</version>
    </parent>
    <artifactId>mcp-platform-bom</artifactId>
    <packaging>pom</packaging>
    <name>Aiwcorpo MCP Platform :: BOM</name>
    <description>Bill of materials for MCP servers: versions of the platform starter, test support, mcp-contracts and Spring AI.</description>

    <url>https://github.com/aiwcorpo/mcp-starter-lib</url>
    <inceptionYear>2026</inceptionYear>

    <organization>
        <name>aiwcorpo</name>
        <url>https://github.com/aiwcorpo</url>
    </organization>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <!-- The organization stands in for a person: Central requires developer information but not an e-mail address,
         and a published POM is public and permanent, so no private address goes into it. -->
    <developers>
        <developer>
            <id>aiwcorpo</id>
            <name>aiwcorpo</name>
            <organization>aiwcorpo</organization>
            <organizationUrl>https://github.com/aiwcorpo</organizationUrl>
        </developer>
    </developers>

    <scm>
        <url>https://github.com/aiwcorpo/mcp-starter-lib</url>
        <connection>scm:git:https://github.com/aiwcorpo/mcp-starter-lib.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/aiwcorpo/mcp-starter-lib.git</developerConnection>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/aiwcorpo/mcp-starter-lib/issues</url>
    </issueManagement>

    <properties>
        <spring-ai.version>2.0.0</spring-ai.version>
        <mcp-contracts.version>7.0.0</mcp-contracts.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>pl.aiwcorpo.mcp</groupId>
                <artifactId>mcp-platform-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- Test scope in servers: test gateway (JWKS + internal JWT from the published test keys). -->
            <dependency>
                <groupId>pl.aiwcorpo.mcp</groupId>
                <artifactId>mcp-platform-test</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>pl.aiwcorpo.mcp</groupId>
                <artifactId>mcp-contracts</artifactId>
                <version>${mcp-contracts.version}</version>
            </dependency>
            <!-- Cedar entity builder (C7, C9), version managed so the starter, the gateway and a server that needs
                 it use one. It brings the native cedar-java library: servers must not add it only for identifier
                 patterns (ArgumentLimits.contractPattern reads them from mcp-contracts). -->
            <dependency>
                <groupId>pl.aiwcorpo.mcp</groupId>
                <artifactId>mcp-cedar-entities</artifactId>
                <version>${mcp-contracts.version}</version>
            </dependency>
            <dependency>
                <groupId>pl.aiwcorpo.mcp</groupId>
                <artifactId>mcp-manifest</artifactId>
                <version>${mcp-contracts.version}</version>
            </dependency>
            <!-- Test keys and vectors. Never outside <scope>test</scope>. -->
            <dependency>
                <groupId>pl.aiwcorpo.mcp</groupId>
                <artifactId>mcp-contracts</artifactId>
                <version>${mcp-contracts.version}</version>
                <classifier>test-vectors</classifier>
            </dependency>

            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
